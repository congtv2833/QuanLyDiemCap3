@model TongQuanDto
@{
    ViewData["Title"] = "Trang chủ";
    var hocKy = (HocKy)ViewBag.HocKy;
}

<div class="tieu-de-trang">
    <div>
        <h1>Tổng quan</h1>
        <div class="text-muted small">Năm học @Model.TenNamHoc &ndash; @QuyCheDanhGia.TenHocKy(hocKy)</div>
    </div>
    <form method="get" class="d-flex gap-2">
        <select name="hocKy" class="form-select form-select-sm" style="width: 150px;" onchange="this.form.submit()">
            <option value="1" selected="@(hocKy == HocKy.HocKyI)">Học kỳ I</option>
            <option value="2" selected="@(hocKy == HocKy.HocKyII)">Học kỳ II</option>
            <option value="3" selected="@(hocKy == HocKy.CaNam)">Cả năm</option>
        </select>
    </form>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="the-so-lieu">
            <div class="nhan">Học sinh</div>
            <div class="so">@Model.SoHocSinh</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="the-so-lieu">
            <div class="nhan">Lớp học</div>
            <div class="so">@Model.SoLop</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="the-so-lieu">
            <div class="nhan">Giáo viên</div>
            <div class="so">@Model.SoGiaoVien</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="the-so-lieu">
            <div class="nhan">Đầu điểm đã nhập</div>
            <div class="so">@Model.SoDauDiemDaNhap.ToString("N0")</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="the h-100">
            <h2 class="h6 fw-semibold mb-3">Xếp loại học tập theo lớp</h2>

            @if (Model.ThongKeTheoLop.Count == 0)
            {
                <p class="text-muted mb-0">Chưa có dữ liệu.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Lớp</th>
                            <th class="text-center">Sĩ số</th>
                            <th class="text-center">Tốt</th>
                            <th class="text-center">Khá</th>
                            <th class="text-center">Đạt</th>
                            <th class="text-center">Chưa đạt</th>
                            <th style="width: 180px;">Từ Đạt trở lên</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var lop in Model.ThongKeTheoLop)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="ThongKe" asp-action="TongKetLop"
                                       asp-route-lopId="@lop.LopId" asp-route-hocKy="@((int)hocKy)">@lop.TenLop</a>
                                </td>
                                <td class="text-center">@lop.SiSo</td>
                                <td class="text-center">@lop.SoTot</td>
                                <td class="text-center">@lop.SoKha</td>
                                <td class="text-center">@lop.SoDat</td>
                                <td class="text-center">@lop.SoChuaDat</td>
                                <td>
                                    <div class="progress" style="height: 16px;">
                                        <div class="progress-bar @HienThi.MauTyLe(lop.TyLeTuDatTroLen)"
                                             style="width: @lop.TyLeTuDatTroLen.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                                            @lop.TyLeTuDatTroLen%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="the h-100">
            <h2 class="h6 fw-semibold mb-3">Các đầu điểm theo Thông tư 22</h2>
            <table class="table table-sm mb-3">
                <thead>
                <tr><th>Đầu điểm</th><th class="text-center">Số lượng</th><th class="text-center">Hệ số</th></tr>
                </thead>
                <tbody>
                <tr><td>ĐĐGtx &ndash; thường xuyên</td><td class="text-center">2 &ndash; 4</td><td class="text-center">1</td></tr>
                <tr><td>ĐĐGgk &ndash; giữa kỳ</td><td class="text-center">1</td><td class="text-center">2</td></tr>
                <tr><td>ĐĐGck &ndash; cuối kỳ</td><td class="text-center">1</td><td class="text-center">3</td></tr>
                </tbody>
            </table>

            <div class="small text-muted">
                <div class="mb-2">
                    <strong>ĐTBmhk</strong> = (Tổng ĐĐGtx + 2 &times; ĐĐGgk + 3 &times; ĐĐGck) / (Số ĐĐGtx + 5)
                </div>
                <div>
                    <strong>ĐTBmcn</strong> = (ĐTBmhkI + 2 &times; ĐTBmhkII) / 3
                </div>
            </div>
        </div>
    </div>
</div>
