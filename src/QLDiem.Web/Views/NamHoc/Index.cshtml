@model List<NamHoc>
@{
    ViewData["Title"] = "Năm học";
}

<div class="tieu-de-trang">
    <h1>Năm học</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">Thêm năm học</a>
</div>

<div class="the">
    <table class="table table-sm align-middle mb-0">
        <thead>
        <tr>
            <th>Năm học</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th class="text-center">Trạng thái</th>
            <th class="text-end"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td class="fw-semibold">@n.Ten</td>
                <td>@n.NgayBatDau.ToString("dd/MM/yyyy")</td>
                <td>@n.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                <td class="text-center">
                    @if (n.DangHoatDong)
                    {
                        <span class="nhan-xl xl-tot">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="text-muted small">Đã kết thúc</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.Id">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Xóa năm học @n.Ten?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-muted text-center py-3">Chưa có năm học nào.</td></tr>
        }
        </tbody>
    </table>
</div>
