@model List<GiaoVien>
@{
    ViewData["Title"] = "Giáo viên";
}

<div class="tieu-de-trang">
    <h1>Giáo viên</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">Thêm giáo viên</a>
</div>

<div class="the mb-3">
    <form method="get" class="row g-2">
        <div class="col-sm-6">
            <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control"
                   placeholder="Tìm theo tên, mã hoặc chuyên môn" />
        </div>
        <div class="col-sm-3">
            <button type="submit" class="btn btn-outline-primary w-100">Tìm kiếm</button>
        </div>
    </form>
</div>

<div class="the">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
            <tr>
                <th style="width: 100px;">Mã GV</th>
                <th>Họ và tên</th>
                <th style="width: 80px;">Giới tính</th>
                <th>Chuyên môn</th>
                <th style="width: 130px;">Điện thoại</th>
                <th class="text-center" style="width: 110px;">Trạng thái</th>
                <th class="text-end" style="width: 150px;"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var g in Model)
            {
                <tr>
                    <td>@g.MaGiaoVien</td>
                    <td class="fw-semibold">@g.HoTen</td>
                    <td>@HienThi.TenGioiTinh(g.GioiTinh)</td>
                    <td>@g.ChuyenMon</td>
                    <td>@g.DienThoai</td>
                    <td class="text-center">
                        @if (g.DangCongTac)
                        {
                            <span class="nhan-xl xl-tot">Đang công tác</span>
                        }
                        else
                        {
                            <span class="text-muted small">Đã nghỉ</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@g.Id">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@g.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Xóa giáo viên @g.HoTen?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-muted text-center py-3">Không có giáo viên nào.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
