@model List<XepHangHocSinhDto>
@{
    var lop = (Lop)ViewBag.Lop;
    var hocKy = (HocKy)ViewBag.HocKy;
    ViewData["Title"] = $"Tổng kết lớp {lop.Ten}";
}

<div class="tieu-de-trang">
    <div>
        <h1>Bảng tổng kết lớp @lop.Ten</h1>
        <div class="text-muted small">
            @QuyCheDanhGia.TenHocKy(hocKy)
            @if (lop.GiaoVienChuNhiem is not null)
            {
                <text>&middot; GVCN: @lop.GiaoVienChuNhiem.HoTen</text>
            }
        </div>
    </div>

    <div class="khong-in d-flex gap-2 align-items-center">
        <div class="btn-group btn-group-sm">
            <a class="btn @(hocKy == HocKy.HocKyI ? "btn-primary" : "btn-outline-primary")"
               asp-action="TongKetLop" asp-route-lopId="@lop.Id" asp-route-hocKy="1">HK I</a>
            <a class="btn @(hocKy == HocKy.HocKyII ? "btn-primary" : "btn-outline-primary")"
               asp-action="TongKetLop" asp-route-lopId="@lop.Id" asp-route-hocKy="2">HK II</a>
            <a class="btn @(hocKy == HocKy.CaNam ? "btn-primary" : "btn-outline-primary")"
               asp-action="TongKetLop" asp-route-lopId="@lop.Id" asp-route-hocKy="3">Cả năm</a>
        </div>

        @if (User.IsInRole(VaiTro.Admin))
        {
            <form asp-action="TongKet" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lopId" value="@lop.Id" />
                <input type="hidden" name="hocKy" value="@((int)hocKy)" />
                <button type="submit" class="btn btn-sm btn-success">Chốt tổng kết</button>
            </form>
        }

        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()">In</button>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="the text-muted">Lớp chưa có học sinh.</div>
}
else
{
    <div class="the">
        <div class="text-muted small mb-2">
            Thứ hạng sắp theo điểm bình quân các môn - chỉ để tham khảo. Xếp loại lấy theo bộ tiêu chí của Thông tư 22,
            không lấy theo điểm trung bình chung.
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th style="width: 60px;">Hạng</th>
                    <th style="width: 110px;">Mã HS</th>
                    <th>Họ và tên</th>
                    <th class="text-center" style="width: 110px;">Số môn tính điểm</th>
                    <th class="text-center" style="width: 130px;">Bình quân (tham khảo)</th>
                    <th class="text-center" style="width: 120px;">Xếp loại</th>
                    <th class="text-end khong-in" style="width: 140px;"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var hs in Model)
                {
                    <tr>
                        <td class="text-center">@hs.ThuHang</td>
                        <td>@hs.MaHocSinh</td>
                        <td>@hs.HoTen</td>
                        <td class="text-center">@hs.SoMonTinhDiem</td>
                        <td class="text-center">@HienThi.Diem(hs.DiemBinhQuanThamKhao)</td>
                        <td class="text-center">
                            <span class="@HienThi.CssXepLoai(hs.XepLoai)">@HienThi.TenXepLoai(hs.XepLoai)</span>
                        </td>
                        <td class="text-end khong-in">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-controller="TraCuu" asp-action="HocBa" asp-route-id="@hs.HocSinhId">Chi tiết</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
