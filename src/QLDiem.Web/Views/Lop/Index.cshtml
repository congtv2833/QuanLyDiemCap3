@model List<Lop>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Lớp học";
    var siSo = (Dictionary<int, int>)ViewBag.SiSo;
}

<div class="tieu-de-trang">
    <h1>Lớp học</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">Thêm lớp</a>
</div>

<div class="the mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-sm-4">
            <label class="form-label mb-1">Năm học</label>
            <select name="namHocId" class="form-select" onchange="this.form.submit()"
                    asp-items="(SelectList)ViewBag.DanhSachNamHoc"></select>
        </div>
    </form>
</div>

<div class="the">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
            <tr>
                <th style="width: 100px;">Lớp</th>
                <th class="text-center" style="width: 80px;">Khối</th>
                <th>Giáo viên chủ nhiệm</th>
                <th class="text-center" style="width: 90px;">Sĩ số</th>
                <th class="text-end" style="width: 300px;"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td class="fw-semibold">@l.Ten</td>
                    <td class="text-center">@l.Khoi</td>
                    <td>@(l.GiaoVienChuNhiem?.HoTen ?? "-")</td>
                    <td class="text-center">@(siSo.TryGetValue(l.Id, out var n) ? n : 0)</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary"
                           asp-controller="HocSinh" asp-action="Index" asp-route-lopId="@l.Id">Học sinh</a>
                        <a class="btn btn-sm btn-outline-secondary"
                           asp-controller="PhanCong" asp-action="Index" asp-route-lopId="@l.Id">Phân công</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@l.Id">Sửa</a>
                        <form asp-action="Delete" asp-route-id="@l.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Xóa lớp @l.Ten?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-muted text-center py-3">Năm học này chưa có lớp nào.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
