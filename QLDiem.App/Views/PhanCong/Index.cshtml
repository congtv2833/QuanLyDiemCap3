@model List<PhanCongGiangDay>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Phân công giảng dạy";
    int? lopId = ViewBag.LopId;
}

<div class="tieu-de-trang">
    <div>
        <h1>Phân công giảng dạy</h1>
        <div class="text-muted small">Mỗi môn của một lớp do một giáo viên phụ trách và nhập điểm.</div>
    </div>
    @if (lopId is not null)
    {
        <a class="btn btn-primary btn-sm" asp-action="Create" asp-route-lopId="@lopId">Thêm phân công</a>
    }
</div>

<div class="the mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-sm-5">
            <label class="form-label mb-1">Lớp</label>
            <select name="lopId" class="form-select" onchange="this.form.submit()"
                    asp-items="(SelectList)ViewBag.DanhSachLop">
                <option value="">-- Chọn lớp --</option>
            </select>
        </div>
    </form>
</div>

@if (lopId is null)
{
    <div class="the text-muted">Chọn một lớp để xem phân công giảng dạy.</div>
}
else
{
    <div class="the">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    <th>Môn học</th>
                    <th class="text-center" style="width: 110px;">Số tiết/năm</th>
                    <th class="text-center" style="width: 110px;">Số ĐĐGtx</th>
                    <th>Giáo viên phụ trách</th>
                    <th class="text-end" style="width: 150px;"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var pc in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            @pc.MonHoc.TenMon
                            @if (pc.MonHoc.LoaiDanhGia == LoaiDanhGia.NhanXet)
                            {
                                <span class="badge text-bg-light border ms-1">nhận xét</span>
                            }
                        </td>
                        <td class="text-center">@pc.MonHoc.SoTietNam</td>
                        <td class="text-center">
                            @(pc.MonHoc.LoaiDanhGia == LoaiDanhGia.DiemSo
                                ? pc.MonHoc.SoDauDiemThuongXuyen.ToString() : "-")
                        </td>
                        <td>@pc.GiaoVien.MaGiaoVien &ndash; @pc.GiaoVien.HoTen</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@pc.Id">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@pc.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Xóa phân công môn @pc.MonHoc.TenMon?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted text-center py-3">Lớp này chưa có phân công nào.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
